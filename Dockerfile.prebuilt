# Runtime image from host-built files (scripts/prepare-image.sh). No RUN steps → no CPU emulation when targeting linux/amd64.
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 KOKOROE_DATA_DIR=/tmp/kokoroe
COPY --chown=node:node . .
USER node
EXPOSE 3000
CMD ["node", "server.js"]
