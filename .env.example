# Copy to .env.local and fill in. .env.local is gitignored — never commit a real key.
# Kokoroe calls the Anthropic API directly (not via Bedrock).
ANTHROPIC_API_KEY=

# Optional model overrides (defaults live in src/lib/claude.ts)
# KOKOROE_MODEL_DISCIPLE=claude-sonnet-5-5
# KOKOROE_MODEL_EDITOR=claude-opus-5-5
# KOKOROE_MODEL_SIMULATOR=claude-haiku-5-5

# Optional behaviour (all off by default; the app runs on recorded data without a key)
# KOKOROE_LIVE=1                 # draft / interpret / answer with Claude live (needs the key above)
# KOKOROE_DAILY_USD=5            # stop live calls for the day at this estimated spend
# KOKOROE_SESSION_CALLS=40       # live calls per visitor session
# KOKOROE_IP_CALLS_PER_HOUR=60   # live calls per address per hour
# KOKOROE_IP_STARTS_PER_HOUR=30  # sessions one address may start per hour
# KOKOROE_FIELD=1                # author's master-role test entry (師匠役テスト; local only, see docs/master-role-test.md)
# KOKOROE_STORE=memory           # keep each session's kokoroe-chō in a Managed Agents memory store (D-002; default local JSON)
