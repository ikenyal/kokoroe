{
  "name": "kokoroe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:quick": "tsx --env-file-if-exists=.env.local eval/run.ts --set eval",
    "spike:memory": "tsx --env-file-if-exists=.env.local spikes/managed-agents/memory-store.ts",
    "spike:export": "tsx --env-file-if-exists=.env.local spikes/managed-agents/export-skill.ts",
    "train": "tsx --env-file-if-exists=.env.local eval/train.ts",
    "curve": "tsx --env-file-if-exists=.env.local eval/curve.ts",
    "eval:successor": "tsx --env-file-if-exists=.env.local eval/successor.ts",
    "eval:adversarial": "tsx --env-file-if-exists=.env.local eval/adversarial.ts",
    "eval:smoke": "tsx --env-file-if-exists=.env.local eval/run.ts --disciple v0 --scenes E01,E06,E10,E13,E19",
    "eval:cache-ab": "tsx --env-file-if-exists=.env.local eval/cache-ab.ts",
    "demo:snapshots": "tsx eval/build-snapshots.ts",
    "demo:results": "tsx eval/build-results.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
